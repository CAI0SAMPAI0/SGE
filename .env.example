# ==============================================================================
# SGE - Sistema de Gestão Empresarial
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com seus dados reais:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. DJANGO & AMBIENTE
# ------------------------------------------------------------------------------
# Ambiente de execução: 'dev' (desenvolvimento) ou 'prd' (produção)
DJANGO_ENV=dev

# Chave secreta do Django (gerar uma chave forte em produção)
SECRET_KEY=django-insecure-your-secret-key-here

# Hosts permitidos separados por vírgula (ex: localhost,127.0.0.1,meudominio.com)
ALLOWED_HOSTS=*

# Origens confiáveis para proteção CSRF separadas por vírgula
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (POSTGRESQL)
# ------------------------------------------------------------------------------
# URL de conexão completa (opcional, sobrescreve os campos individuais caso preenchida)
# Exemplo Neon/Railway/Render: postgresql://usuario:senha@host:5432/banco?sslmode=require
POSTGRES_URL=

# Parâmetros individuais do banco de dados (usados pelo Docker Compose / fallback)
POSTGRES_DB=sge
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# ------------------------------------------------------------------------------
# 3. INTELIGÊNCIA ARTIFICIAL (GROQ API)
# ------------------------------------------------------------------------------
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Modelo da Groq a ser utilizado
GROQ_MODEL=


# ------------------------------------------------------------------------------
# 4. CELERY & RABBITMQ (FILAS E TAREFAS ASSÍNCRONAS)
# ------------------------------------------------------------------------------
# URL do broker Celery:
# Localmente: pyamqp://guest:guest@localhost:5672//
# Docker Compose: pyamqp://guest:guest@sge_rabbitmq:5672//
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Credenciais RabbitMQ (usadas pelo Docker Compose)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest


# ------------------------------------------------------------------------------
# 5. WHATSAPP API (WAHA - WhatsApp HTTP API)
# ------------------------------------------------------------------------------
# URL base do serviço WAHA:
WAHA_BASE_URL=

# Chave de segurança para chamadas da API do WAHA (opcional se não configurado)
WAHA_API_KEY=

# URL pública que o WAHA utilizará para enviar webhooks ao Django (ex: https://meudominio.com ou ngrok)
WAHA_WEBHOOK_URL=

# Senha de acesso ao Swagger / Dashboard do WAHA (usado no Docker Compose)
WAHA_DASHBOARD_PASSWORD=


# ------------------------------------------------------------------------------
# 6. E-MAIL / SMTP (NOTIFICAÇÕES E CONVITES)
# ------------------------------------------------------------------------------


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_aplicativo
SMTP_FROM=seu_email@gmail.com
EMAIL_USE_TLS=True
